# 注意：section 名是历史标签（沿用迁入 modules/ 之前的路径），git 只认下面的 path。
# 不要按 section 名去找目录；改 path 时两个字段一起核对。
[submodule "KernelPatch"]
	path = KernelPatch
	url = https://github.com/bmax121/KernelPatch/
[submodule "zram_zstd/upstream/zstd"]
	path = modules/KPM/zram_zstd/zstd
	url = https://github.com/facebook/zstd.git
[submodule "nomount/nomount"]
	path = modules/KPM/nomount/nomount
	url = https://github.com/maxsteeel/nomount.git
